from queue import Queue

def bfs(graph, start):
    queue = Queue()
    queue.put(start)
    visited = {start}

    while not queue.empty():
        node = queue.get()
        print(node, end=" ")

        for neighbor in graph[node]:
            if neighbor not in visited:
                visited.add(neighbor)
                queue.put(neighbor)


# Example graph
graph = {
    "A": ["B", "C"],
    "B": ["A", "D", "E"],
    "C": ["A", "F"],
    "D": ["B"],
    "E": ["B", "F"],
    "F": ["C", "E"]
}

print("BFS starting from node A:")
bfs(graph, "A")
